# GharKaGod Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Settings
PROJECT_NAME="GharKaGod"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Security & Session Secrets
# Replace SECRET_KEY in production with a 256-bit random string (e.g. openssl rand -hex 32)
SECRET_KEY="gharkagod-secure-jwt-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite locally, PostgreSQL in production)
# SQLite: sqlite:///./gharkagod.db
# PostgreSQL: postgresql://username:password@localhost:5432/gharkagod
DATABASE_URL="sqlite:///./gharkagod.db"

# Google Gemini GenAI API
# Optional: If omitted, GharKaGod uses the verified deterministic evidence fallback.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=10

# External Public Environmental Data Provider
OPEN_METEO_AQI_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
AQI_CACHE_TTL_SECONDS=1800
